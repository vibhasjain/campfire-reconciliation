  9f8896906d83de04 t("Concept A — Workpaper",Inter,40,b,align(l),lh(1.2)) p(0,0) s(fill,hug:48) ext(1440,) f[(6f13948de3680bfd,#0B1F16)] "Text 2018"
  07de984870804ce8 t("Review by exception. Ember drafts the September reconciliation as a workpaper: the bank-to-book bridge on top, its proposed resolutions below. Maya signs lines one at a time or in batches; what needs her judgment floats to the top, the rest is one keystroke. The signed workpaper is the audit trail Daniel reviews.",Inter,18,r,align(l),lh(1.5)) p(0,56) s(fill,hug:54) ext(1440,) f[(2eefb32899f94b19,#1F3329)] "Text 2019"
  9581523f36989860 t("Arbor Analytics · 1010 Chase Operating ••4821 · Sep 2026 · BD3 · 14 exceptions · Frames A1–A6 at 1440×900, A7 at 390×844 · stickies on the right are design notes, not UI",Inter,14,r,align(l),lh(1.5)) p(0,118) s(fill,hug:21) ext(1440,) f[(7cb01c278bba55c8,#5C6B62)] "Text 2020"
fd9ed8249eb241b3 al(v,g(10),pad(22,24,24,24)) p(1500,0) s(440,hug:444.4) f[(2d579c3f076d52e8,#FFF5CF)] rd(4) "Note A1"
  fdd9e0132ad1a04b t("A1 Hero · opening the draft",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(1ff9d5fd04a60924,#3B3000)] "Text 2021"
  41dadc38c52565de t("Ember has already done the reconciliation, so Maya opens a draft workpaper, not a queue. The bridge sits on top with two columns: Draft (Ember’s proposal, ties to $0.00) and Signed (only her ticks, still ($82,741.31)). Done means the two columns agree.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:105) ext(392,) f[(774fbd0f0b8590c6,#4A3F12)] "Text 2022"
    spans[(59,74,b),(130,135,b),(174,180,b)]
  a4c048b8338acf2e t("Review by exception: the 5 items that need judgment sit in one AI card; the 9 routine ones sit below, grouped by what signing does (timing, entries, matches), with one batch key.",Inter,14,r,align(l),lh(1.5)) p(24,169.4) s(fill,hug:84) ext(392,) f[(716422ccdb53a390,#4A3F12)] "Text 2023"
  62f4328777f806d3 t("Items that need Daniel sort first because his approval takes time; then lowest confidence. Refs (B1, C4, M2) replace row numbers so people can talk about a line. Comments sit in the margin next to the line they discuss, as in Google Docs.",Inter,14,r,align(l),lh(1.5)) p(24,263.4) s(fill,hug:105) ext(392,) f[(e33595086c243ffd,#4A3F12)] "Text 2024"
  29bf998af0af0e4c t("Trade-off: the raw bank and book lines are one level down (Space). That is the bet.",Inter,14,r,align(l),lh(1.5)) p(24,378.4) s(fill,hug:42) ext(392,) f[(0e1e7d30dda89f0f,#4A3F12)] "Text 2025"
    spans[(0,10,b)]
74ea0a92d7c1d7ec al(v,g(10),pad(22,24,24,24)) p(1500,1200) s(440,hug:402.4) f[(c33beff2b3d4522c,#FFF5CF)] rd(4) "Note A2"
  53a43dc1c9c6dec8 t("A2 Why · checking the AWS fix",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(c49eacba3c2bb089,#3B3000)] "Text 2026"
  b68849843c28dae0 t("Space expands a line in place: source lines (bank vs book, Δ 180.00), the options (← →), and the formula, with 5 factors and weight × score summing to 0.879, shown as 88%.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:84) ext(392,) f[(9f61d3705acb7a80,#4A3F12)] "Text 2027"
  142e7a9a3370aefc t("The invoice opens in the margin where comments usually sit (E), so evidence and reasoning are side by side without a modal. The effect line says what signing will change (bill and payment edited, cash +$180, Priya notified) before she presses A.",Inter,14,r,align(l),lh(1.5)) p(24,148.4) s(fill,hug:105) ext(392,) f[(b249ddfcb4488bf2,#4A3F12)] "Text 2028"
  93e6d621b23ff0cd t("Meanwhile Maya asked @ember about Notion in C7’s thread. Ember works in the background and she keeps going, so the page never waits on the agent.",Inter,14,r,align(l),lh(1.5)) p(24,263.4) s(fill,hug:63) ext(392,) f[(d9339f5ae7a38baa,#4A3F12)] "Text 2029"
  3404c3476c78c183 t("Trade-off: the why table is dense. For items at 90% or above it stays collapsed.",Inter,14,r,align(l),lh(1.5)) p(24,336.4) s(fill,hug:42) ext(392,) f[(d541ded438109b15,#4A3F12)] "Text 2030"
    spans[(0,10,b)]
53c3e2e911b2ae9e al(v,g(10),pad(22,24,24,24)) p(1500,2400) s(440,hug:308.4) f[(6ee0b18545bf372c,#FFF5CF)] rd(4) "Note A3"
  e724675f1666a4ac t("A3 Thread · Ember edits the workpaper",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(2189835800ebe365,#3B3000)] "Text 2031"
  65ccc42e4ceab7ec t("The question lives on C7. Ember searched the AP inbox, found NTN-88213 and changed the line: a new option 1 at 96%, the PDF attached, the memo set, and the “expense now” option dropped. Each tool call is listed with its own Revert, and ⌘Z undoes the last one.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:105) ext(392,) f[(8f7ef63b7cb64908,#4A3F12)] "Text 2032"
    spans[(224,230,b)]
  619d7151dc9bf2e8 t("The line flashes lime and says “Updated by Ember · was 72%”, so a change is never silent. The old option stays one arrow key away.",Inter,14,r,align(l),lh(1.5)) p(24,169.4) s(fill,hug:63) ext(392,) f[(c440842910a4cd75,#4A3F12)] "Text 2033"
  bb9aca7a9260cd8e t("C4 is signed now (MP tick) and the Signed column moved by +$180. Every action lands in the bridge.",Inter,14,r,align(l),lh(1.5)) p(24,242.4) s(fill,hug:42) ext(392,) f[(fd903feecf289fd0,#4A3F12)] "Text 2034"
0dcde5b7abd3e9d6 al(v,g(10),pad(22,24,24,24)) p(1500,3600) s(440,hug:381.4) f[(daa8abb320890435,#FFF5CF)] rd(4) "Note A4"
  5193c0d11ea21508 t("A4 Batch · one keystroke for the routine nine",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(1b789803fbba4f59,#3B3000)] "Text 2035"
  fe4a56e056b51e10 t("⇧A opens a confirm sheet, not an instant action. It lists the items and what signing does to the bridge: bank +82,550.00, books +10,466.67, difference ($72,146.31) → ($62.98).",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:84) ext(392,) f[(6694c09696b87f1f,#4A3F12)] "Text 2036"
  bfeceaab328d5d4a t("Ember suggests which one to spot-check (M2: one deposit, three invoices). Maya holds it with Space and signs 8.",Inter,14,r,align(l),lh(1.5)) p(24,148.4) s(fill,hug:63) ext(392,) f[(93836e6663d3757a,#4A3F12)] "Text 2037"
  66d75c4ab4389c23 t("After the batch, the remaining difference equals C5’s FX loss exactly, so the bridge tells her what is left without a list.",Inter,14,r,align(l),lh(1.5)) p(24,221.4) s(fill,hug:63) ext(392,) f[(a6017d3f766e1536,#4A3F12)] "Text 2038"
  397682db5fba58db t("Risk: batch signing invites rubber-stamping. The guards are the 90% line, Ember’s sampling pick, the delta preview, undo on every line, and “signed in batch” in the audit trail.",Inter,14,r,align(l),lh(1.5)) p(24,294.4) s(fill,hug:63) ext(392,) f[(046554549e24d58a,#4A3F12)] "Text 2039"
    spans[(0,5,b)]
9ad956c5706118a2 al(v,g(10),pad(22,24,24,24)) p(1500,4800) s(440,hug:329.4) f[(8fe7f45eb71a5ebe,#FFF5CF)] rd(4) "Note A5"
  e64a001b68a7c265 t("A5 Many-to-one · the held Cascade deposit",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(c06ad3f2d87bf301,#3B3000)] "Text 2040"
  ebd8a3f98fdb2173 t("Expanding M2 shows its source lines. Maya ⌘-clicks the deposit and three invoices; the selection bar adds up both sides (61,250.00 = 61,250.00, Δ 0.00) and M matches them. The outcome equals accepting Ember’s proposal, but she did it herself. The manual path works in any expanded line and in the auto-matched appendix.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:126) ext(392,) f[(de4f04be1f9cca7c,#4A3F12)] "Text 2041"
  73399199904a713c t("The remittance advice opens in the margin with the three invoices ticked. ⌘J answers whole-page questions (“What’s left?”) and links to lines.",Inter,14,r,align(l),lh(1.5)) p(24,190.4) s(fill,hug:63) ext(392,) f[(5740176db402ee93,#4A3F12)] "Text 2042"
  55a5be305ed68186 t("The toast keeps the batch undoable; hovering a signed row shows U to unsign.",Inter,14,r,align(l),lh(1.5)) p(24,263.4) s(fill,hug:42) ext(392,) f[(91c8efda6c739446,#4A3F12)] "Text 2043"
237ad6030fea0c94 al(v,g(10),pad(22,24,24,24)) p(1500,6000) s(440,hug:308.4) f[(242e5bc1a823fdde,#FFF5CF)] rd(4) "Note A6"
  c6c23d120a3aff77 t("A6 Done · ties out",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(73f2aedf625d198a,#3B3000)] "Text 2044"
  7f9ffccb55a87fdb t("Done shows in three places: the banner (Ties out · $0.00) with Complete reconciliation, the bridge columns agreeing with a green difference row, and the top bar reading 0 left · $0.00 with the button enabled.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:84) ext(392,) f[(f7df77944ccebcc5,#4A3F12)] "Text 2045"
  30bbbb6d906e1f5b t("The workpaper is now the record. Every line has Maya’s tick or Daniel’s approval, and the margin holds the audit trail: who did what, Ember’s edits, threads resolved. It exports as a PDF.",Inter,14,r,align(l),lh(1.5)) p(24,148.4) s(fill,hug:84) ext(392,) f[(9e3cda13b00d9705,#4A3F12)] "Text 2046"
  45f2cdaa08f47f09 t("Complete sends the signed workpaper to Daniel for review and locks September for GL 1010.",Inter,14,r,align(l),lh(1.5)) p(24,242.4) s(fill,hug:42) ext(392,) f[(3daeabbf3ee1150b,#4A3F12)] "Text 2047"
96ddac09137cb782 al(v,g(10),pad(22,24,24,24)) p(430,7200) s(440,hug:235.4) f[(756a924d4d26e9aa,#FFF5CF)] rd(4) "Note A7"
  055d32c800b527b1 t("A7 Daniel · phone",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(392,) f[(90d15e25b99cc706,#3B3000)] "Text 2048"
  6cc196fc5e58c360 t("Approval items go to Daniel early (A2), so he can approve from his phone while Maya works; his approval never becomes the last blocker.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:63) ext(392,) f[(71f0d79fa801c7dd,#4A3F12)] "Text 2049"
  cace31d3e88bab8f t("Each card shows Ember’s proposal, the evidence in plain lines, and where it came from. C6 cites Daniel’s own rule from his comment. He sees only what needs him, so review by exception works for the approver too.",Inter,14,r,align(l),lh(1.5)) p(24,127.4) s(fill,hug:84) ext(392,) f[(4233de1bdec0657e,#4A3F12)] "Text 2050"
f59c785d41fdb241 al(v,g(10),pad(22,24,24,24)) p(1980,0) s(420,hug:360.4) f[(3eca072ab66d9747,#FFF5CF)] rd(4) "Note Risks"
  f8c554c88a279eb8 t("Where this bet could be wrong for Maya",Inter,16,b,align(l),lh(1.4)) p(24,22) s(fill,hug:22.4) ext(372,) f[(94ab025ea160e622,#3B3000)] "Text 2051"
  f8da9ffbf448ecc0 t("Chronology. Grouping by decision type hides date order, and Maya ties out against the PDF statement by date. Add a “statement order” toggle to the workpaper.",Inter,14,r,align(l),lh(1.5)) p(24,54.4) s(fill,hug:63) ext(372,) f[(3210ac82b91abd4e,#4A3F12)] "Text 2052"
    spans[(0,11,b)]
  31a28217d6dfa42b t("Distrust costs a keystroke per line. If she doesn’t trust Ember yet, opening source lines one at a time is slow. L expands all source lines, which turns the workpaper back into a ledger.",Inter,14,r,align(l),lh(1.5)) p(24,127.4) s(fill,hug:84) ext(372,) f[(f4871b0a1482599d,#4A3F12)] "Text 2053"
    spans[(0,36,b)]
  d384396292ee1693 t("Two columns may confuse. Test whether Maya reads Signed, not Draft, as the real difference. If not, show Draft only as a ghost value.",Inter,14,r,align(l),lh(1.5)) p(24,221.4) s(fill,hug:63) ext(372,) f[(825d5176fcaf3113,#4A3F12)] "Text 2054"
    spans[(0,24,b)]
  74580f0d4d7aa9eb t("Rubber-stamping. Keep the batch threshold visible and log batch signs separately for Daniel.",Inter,14,r,align(l),lh(1.5)) p(24,294.4) s(fill,hug:42) ext(372,) f[(eb8c8c33edf2a588,#4A3F12)] "Text 2055"
