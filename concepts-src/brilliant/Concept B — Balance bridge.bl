  76e7561c1e03768a t("Tray chips lost their amounts: these matches can’t move the balance, so a dollar figure there is noise.",Inter,14,r,align(l),lh(1.6)) p(22,43.6) s(fill,hug:44.8) ext(376,) f[(68f079dc1e923535,#1F3329)] "Text 2810"
  b8e387747e95b31e t("Match is the focused button, so its M hint shows; nothing else carries a key hint.",Inter,14,r,align(l),lh(1.6)) p(22,98.4) s(fill,hug:44.8) ext(376,) f[(9452dc67c7eab417,#1F3329)] "Text 2811"
