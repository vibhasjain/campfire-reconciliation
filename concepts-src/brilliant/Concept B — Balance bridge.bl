  193d13f7817d76f9 t("Thread only. Two live changes, each with Revert, are the point of the frame.",Inter,14,r,align(l),lh(1.6)) p(22,43.6) s(fill,hug:44.8) ext(376,) f[(16e72ed56ea76255,#1F3329)] "Text 2807"
  46929e678667618a t("Cut: the search chip, Priya’s reply, the journal-entry preview and the alternatives list (the 1 of 2 control covers them).",Inter,14,r,align(l),lh(1.6)) p(22,98.4) s(fill,hug:67.2) ext(376,) f[(03e2c583bfc60069,#1F3329)] "Text 2808"
