  0ee1ec7a8fd6e015 t("Cut: confidence on the 13 unselected planks, the before/after balance block, the LINES block, tabs, the hint bar, the BD3 chip, the subline, the laid counters, the √ toggle and the top-bar Complete button.",Inter,14,r,align(l),lh(1.6)) p(22,43.6) s(fill,hug:89.6) ext(376,) f[(25a1d491a4e7926d,#1F3329)] "Text 2801"
