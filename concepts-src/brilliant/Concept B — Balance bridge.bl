  8838af80ace1c7a7 t("The why keeps weight × score per factor. Its total is the 88% pill, so it isn’t printed twice.",Inter,14,r,align(l),lh(1.6)) p(22,43.6) s(fill,hug:44.8) ext(376,) f[(cf6dff75ee76c7bf,#1F3329)] "Text 2804"
  3d640c765017c254 t("Evidence opens on demand in place of the thread; the swapped digits are the only color.",Inter,14,r,align(l),lh(1.6)) p(22,98.4) s(fill,hug:44.8) ext(376,) f[(2e402abbd5342325,#1F3329)] "Text 2805"
