  eaf50bb747317a71 t("B7 PHONE",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(04425c67776a79f4,#8A7A3E)] "Text 1909"
  e317c39830f6cd24 t("The bridge fits in a pocket",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(b9e30d421ff3bcd8,#0B1F16)] "Text 1910"
  02149cbd4f59c854 t("Daniel approves from his phone. The keystone and a mini bridge come first: grey-green segments are the entries waiting on him, and they add up to the whole difference.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:89.6) ext(376,) f[(e80014b0356a0669,#1F3329)] "Text 1911"
  19a4c2e37078a67d t("Only his two cards follow, each with Maya’s note and the entry itself. Approve lays the plank and Maya’s bridge locks. The concept survives shrinking because the number and the deck say it all.",Inter,14,r,align(l),lh(1.6)) p(22,184.6) s(fill,hug:89.6) ext(376,) f[(d96beff98ddf874b,#1F3329)] "Text 1912"
