  67a1483886ca80bf t("Concept B — Balance bridge",Inter,40,r,align(l),lh(1.2),ls(-0.8px)) p(0,0) s(fill,hug:48) ext(1440,) f[(41e45b0ea39007e2,#0B1F16)] "Text 1874"
  e181d5b49b4878bf t("The difference is the interface. Every unmatched item is a plank on the rec equation, hung under the side it moves and sized by how much of the gap it explains. Accepting lays the plank; at $0.00 the two sides meet and lock.",Inter,18,r,align(l),lh(1.6)) p(0,58) s(fill,hug:57.61) ext(1440,) f[(6745be6be540cd4d,#1F3329)] "Text 1875"
  54403419bd7cd3ee t("Arbor Analytics · 1010 Chase Operating ••4821 · Sep 2026 · Maya Patel, BD3 · frames 1440 × 900, left to right",Inter,14,r,align(l),lh(1.4)) p(0,125.61) s(fill,hug:19.61) ext(1440,) f[(e9265ac0658a1520,#5C6B62)] "Text 1876"
1eb3bcdfcf19c56b al(v,g(12),pad(20,22)) p(1480,0) s(420,hug:554.2) f[(fd03569dceb336ac,#FFFDF4)] st[(48fbf135697d5c43,#E9E2C8,w(1))] rd(12) "Note B1 Hero"
  7562250ae9e803a0 t("B1 HERO",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(97ca73b7ef1a1f51,#8A7A3E)] "Text 1877"
  ed405632cbea2eb9 t("What Maya sees first",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(22cf8f817fb69662,#0B1F16)] "Text 1878"
  1521739eedfbf3db t("The page is the rec statement, drawn as a bridge: Statement ending → in transit / outstanding → Adjusted bank | DIFFERENCE | Adjusted book ← book adjustments ← GL balance. It’s the worksheet she already files, made live.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:112) ext(376,) f[(5e125407d53dd207,#1F3329)] "Text 1879"
  062e48b1e817ff94 t("Each unmatched item is a plank hanging under the side it moves. Width is √impact with a 70px floor: at linear scale Meridian ($86.4k, more than the whole $82.7k gap) would leave 7 of 10 planks invisible. The √ / linear toggle keeps it honest.",Inter,14,r,align(l),lh(1.6)) p(22,207) s(fill,hug:112) ext(376,) f[(5320e75cf26f4938,#1F3329)] "Text 1880"
  6246d1944aa1ff04 t("The keystone answers “why is it off?” before any click: suggestions explain all $82,741.31, so if they’re right she lands on $0.00.",Inter,14,r,align(l),lh(1.6)) p(22,331) s(fill,hug:67.2) ext(376,) f[(f8b8ab09d841a836,#1F3329)] "Text 1881"
  ce41757aa22fa8b2 t("Default selection is the plank that explains the most. Four cash-neutral matches sit in their own tray: they can’t move the number, but a wrong pair is still wrong.",Inter,14,r,align(l),lh(1.6)) p(22,410.2) s(fill,hug:67.2) ext(376,) f[(8234a4bca862f595,#1F3329)] "Text 1882"
  8ae438185719f59e t("Trade-off: the bridge costs ~300px, so the detail below shows one item at a time.",Inter,14,r,align(l),lh(1.6)) p(22,489.4) s(fill,hug:44.8) ext(376,) f[(3c42c71f57d688cf,#1F3329)] "Text 1883"
70897b4b4b2b3575 al(v,g(12),pad(20,22)) p(3480,0) s(420,hug:395.8) f[(04e1dd20bbf67410,#FFFDF4)] st[(c0468da79b1eafa8,#E9E2C8,w(1))] rd(12) "Note B2 Why"
  c01641af426f8b42 t("B2 WHY",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(fcf58910c9b8f795,#8A7A3E)] "Text 1884"
  5b65c94ece22fa62 t("Resolving with the formula open",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(e1ad347c4d0ed1cf,#0B1F16)] "Text 1885"
  37f6adc0707dca29 t("Two keystrokes lay the bank side: Adjusted bank is final at $9,029,866.58, and the ($191.31) left is exactly the net of the 8 book planks.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:67.2) ext(376,) f[(46e5be8564089875,#1F3329)] "Text 1886"
  72eb09f5e4f32d8f t("Every suggestion previews its effect on the bridge. The surprise sketching found: accepting AWS makes the difference bigger, ($191.31) → ($371.31). The gap isn’t monotonic (interest, Datadog and AWS push the other way), so the keystone says “explained”, never “closer”. Progress is the laid deck, not the number.",Inter,14,r,align(l),lh(1.6)) p(22,162.2) s(fill,hug:134.4) ext(376,) f[(25d166803f237110,#1F3329)] "Text 1887"
  e9b55c793082aa7c t("Why = weight × score per factor, summed to 88%. Evidence opens beside it with the transposed digits marked (42 vs 24).",Inter,14,r,align(l),lh(1.6)) p(22,308.6) s(fill,hug:67.2) ext(376,) f[(f71b1e3b8e4ad4d6,#1F3329)] "Text 1888"
30f0c87eb3da7c56 al(v,g(12),pad(20,22)) p(5480,0) s(420,hug:373.4) f[(b244d28068ff1bb7,#FFFDF4)] st[(446e65a7b963e549,#E9E2C8,w(1))] rd(12) "Note B3 Thread"
  dfde0915a95d88c9 t("B3 THREAD",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(8d8fe53940658d46,#8A7A3E)] "Text 1889"
  d9b561aa3fb7a552 t("Ember changes the UI from the thread",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(881bb7141fee2a4f,#0B1F16)] "Text 1890"
  62c43189b22e3611 t("Each plank has its own thread with Maya, Priya and Ember. Maya asks @ember for an invoice; the tool call finds NTN-88213 in the AP inbox.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:67.2) ext(376,) f[(cd90f79272a85294,#1F3329)] "Text 1891"
  aa2a964522ebd491 t("Two live changes, each with its own Revert: a new 96% candidate goes to the top, and “Expense now” is dropped. The plank on the bridge updates 72% → 96% and carries an Ember badge, so changes are visible from the overview too.",Inter,14,r,align(l),lh(1.6)) p(22,162.2) s(fill,hug:112) ext(376,) f[(9820f3e001c7c837,#1F3329)] "Text 1892"
  98fe321a2e0ee36c t("All candidates for an item move the same cash, so the difference stays ($3,997.98) until she accepts. Treatment changes; the bridge doesn’t.",Inter,14,r,align(l),lh(1.6)) p(22,286.2) s(fill,hug:67.2) ext(376,) f[(9856ef230486fbfc,#1F3329)] "Text 1893"
92b39b3d8e1f8deb al(v,g(12),pad(20,22)) p(7480,0) s(420,hug:395.8) f[(8a7362507063f0dc,#FFFDF4)] st[(01518442639a30a7,#E9E2C8,w(1))] rd(12) "Note B4 Cascade"
  e1469ceffbca6520 t("B4 CASCADE",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(a0dc09d8ea9d9064,#8A7A3E)] "Text 1894"
  b2be869c8c29239f t("Items that don’t move the number",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(4ba808ad56b70f55,#0B1F16)] "Text 1895"
  27ee3815c9604862 t("The tray is where cash-neutral work lives. Cascade: one $61,250 deposit, three receipts. Maya ⌘-clicks the four lines; the sum bar proves bank = books before M matches.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:89.6) ext(376,) f[(76319d2cfb34d20d,#1F3329)] "Text 1896"
  16795b46cdc9e796 t("The bridge gives no reward here: the difference stays $5,602.02. So the tray keeps its own counter (3 of 4 confirmed), and “done” needs both the deck and the tray.",Inter,14,r,align(l),lh(1.6)) p(22,184.6) s(fill,hug:89.6) ext(376,) f[(ca57d33dc7ef1241,#1F3329)] "Text 1897"
  8dfc6d80d4ac9922 t("What I’d change after sketching: 4 of 14 items sit in a strip that looks secondary. In a busier month, matches could be most of the work, and the tray would need to grow into a real list.",Inter,14,r,align(l),lh(1.6)) p(22,286.2) s(fill,hug:89.6) ext(376,) f[(4bda9285d1063f9f,#1F3329)] "Text 1898"
0489b85ad5a5fae3 al(v,g(12),pad(20,22)) p(9480,0) s(420,hug:328.6) f[(bc0a724f0af20d91,#FFFDF4)] st[(831fa1a6634f46dd,#E9E2C8,w(1))] rd(12) "Note B5 What’s left"
  7c38fe5a7a656ac3 t("B5 WHAT’S LEFT",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(1c4bfcfdc907f69f,#8A7A3E)] "Text 1899"
  9d596d9ec9cd333e t("⌘J answers in the bridge’s language",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(d95c2a9dbd0a2eaf,#0B1F16)] "Text 1900"
  ccb686e36349cc52 t("The page chat answers “what’s left?” in dollars: the remaining ($1,175.00) is exactly the two entries waiting on Daniel.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:67.2) ext(376,) f[(4ffdef019ba81abd,#1F3329)] "Text 1901"
  6bd1ce975e61a964 t("Accepted-but-unapproved planks are laid provisionally (grey-green deck, dashed card, DK avatar) and don’t count toward the difference, so $0.00 can’t appear before the controller signs. Complete stays locked.",Inter,14,r,align(l),lh(1.6)) p(22,162.2) s(fill,hug:89.6) ext(376,) f[(c8fc8c807050c2d9,#1F3329)] "Text 1902"
  ceed6ef28d736b23 t("Nudging Daniel is one click, from the chat or from the plank’s thread, where his original request still sits.",Inter,14,r,align(l),lh(1.6)) p(22,263.8) s(fill,hug:44.8) ext(376,) f[(56a6d357f56b2668,#1F3329)] "Text 1903"
41f45db7ababeb82 al(v,g(12),pad(20,22)) p(11480,0) s(420,hug:328.6) f[(5636abe72a249157,#FFFDF4)] st[(d9d8686acc021169,#E9E2C8,w(1))] rd(12) "Note B6 Done"
  4914c11087d448f8 t("B6 DONE",Inter,12,sb,align(l),lh(1.3),ls(0.6px)) p(22,20) s(fill,hug:15.6) ext(376,) f[(383bdae50d1fe3e1,#8A7A3E)] "Text 1904"
  4cabc9ce8398bad4 t("Done at a glance",Inter,18,sb,align(l),lh(1.3)) p(22,47.6) s(fill,hug:23.4) ext(376,) f[(4bf3614ce11b84b0,#0B1F16)] "Text 1905"
  3a9a4a302ac03390 t("Continuous green deck, a lock at the joint, $0.00 in a tinted keystone, both piers at $9,029,866.58, tray 4 of 4. It reads from across the room.",Inter,14,r,align(l),lh(1.6)) p(22,83) s(fill,hug:67.2) ext(376,) f[(c0bb6a8aadf80e15,#1F3329)] "Text 1906"
  12dad6c4d1100fc7 t("The lower half becomes the workpaper Maya files (the classic rec statement) plus sign-off: 12 accepted as suggested, 1 found by Ember, 1 matched by hand, Daniel’s 2 approvals.",Inter,14,r,align(l),lh(1.6)) p(22,162.2) s(fill,hug:89.6) ext(376,) f[(d581005750dee80b,#1F3329)] "Text 1907"
  910a72073a8246ae t("Complete reconciliation is the only primary action left on the page, in both the top bar and the sign-off card.",Inter,14,r,align(l),lh(1.6)) p(22,263.8) s(fill,hug:44.8) ext(376,) f[(8e9b80fc0294dfff,#1F3329)] "Text 1908"
