  f6dc77d695e35ddb t("Ember names the two approvals without re-stating dollars: the planks already carry them, and the keystone carries the total.",Inter,14,r,align(l),lh(1.6)) p(22,43.6) s(fill,hug:67.2) ext(376,) f[(6aac66f0af744dbe,#1F3329)] "Text 2813"
